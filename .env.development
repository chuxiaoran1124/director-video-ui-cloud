# 开发环境配置
VITE_PORT = 3002

# API 地址（手动改这里）
# 本机后端示例：http://127.0.0.1:8000
# 测试后端示例：http://192.168.110.10:8000
VITE_API_URL = http://127.0.0.1:8000

# 代理配置（手动改这里，保持和 VITE_API_URL 一致）
# 格式：[["/api","后端地址"]]
VITE_PROXY=[["/api","http://127.0.0.1:8000"],["/tos-proxy","https://test-basket.tos-cn-beijing.volces.com"]]

# mock 配置
# 设置不需要 mock 的接口路径
VITE_IGNORE_MOCK = ["/api/users/login/"]
 
# 全局水印开关（开发环境建议关闭）
VITE_WATERMARK=False