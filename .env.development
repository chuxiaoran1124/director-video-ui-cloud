# 开发环境配置
VITE_PORT = 3002

# API 地址
# 修改为你的实际后端地址，例如：http://localhost:8080
VITE_API_URL=http://localhost:8000

# 代理配置
# 格式：[["/api-prefix", "target-url"], ...]
VITE_PROXY=[["/api","http://127.0.0.1:8000"]]

# mock 配置
# 设置不需要 mock 的接口路径
VITE_IGNORE_MOCK = ["/api/users/login/"]
 
# 全局水印开关（开发环境建议关闭）
VITE_WATERMARK=true